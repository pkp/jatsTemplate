<contrib-group>
    <contrib contrib-type="author" corresp="yes">
        <name-alternatives>
            <string-name specific-use="display">author-preferred-name</string-name>
            <name name-style="western" specific-use="primary">
                <surname>author-lastname</surname>
                <given-names>author-firstname</given-names>
            </name>
        </name-alternatives>
        <bio xml:lang="en">
            <p>Test biography</p>
        </bio>
        <address>
            <country country="GB">United Kingdom</country>
        </address>
        <email>someone@example.com</email>
        <uri>https://example.com</uri>
        <xref ref-type="aff" rid="aff-1"/>
        <xref ref-type="corresp" rid="corresp-1"/>
        <xref ref-type="author-notes" rid="con-1"/>
    </contrib>
    <contrib contrib-type="author">
        <collab>second-author-organization</collab>
    </contrib>
</contrib-group>
